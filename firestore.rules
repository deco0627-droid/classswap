rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() { return request.auth.token.email.lower(); }
    function myAdminDoc() { return get(/databases/$(database)/documents/admins/$(myEmail())); }

    // 로그인했고(구글), edu.jkjin@gmail.com 고정 계정이거나 admins 컬렉션에 등록된 이메일만 승인.
    function isApproved() {
      return request.auth != null && (
        myEmail() == 'edu.jkjin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(myEmail()))
      );
    }
    // 관리자 역할: 고정 계정이거나, admins 문서의 role 필드가 'admin'인 경우만.
    // (role 필드가 아예 없는 예전 문서는 .get()의 기본값 'teacher'로 처리돼 관리자가 아님)
    function isAdminRole() {
      return request.auth != null && (
        myEmail() == 'edu.jkjin@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(myEmail())) && myAdminDoc().data.get('role', 'teacher') == 'admin')
      );
    }
    function myTeacherId() {
      return exists(/databases/$(database)/documents/admins/$(myEmail()))
        ? myAdminDoc().data.get('linkedTeacherId', null)
        : null;
    }

    // 교사·시간표·출장 전체가 들어있는 문서. 관리자만 읽고 쓸 수 있다 — 교사(일반) 역할은
    // 여기 절대 접근 못 하고, 대신 아래 classswap_myview에서 자기 것만 본다.
    match /classswap/{docId} {
      allow read, write: if isAdminRole();
    }

    // 승인 목록(문서 id = 소문자 이메일). 관리자는 전체를 보고 관리하고, 그 외 승인된 계정은
    // 로그인 직후 "내 역할·내가 어느 교사인지" 확인을 위해 자기 자신의 문서만 조회 가능.
    match /admins/{email} {
      allow get: if isAdminRole() || (request.auth != null && myEmail() == email);
      allow list: if isAdminRole();
      allow write: if isAdminRole();
    }

    // 관리자가 저장할 때마다 교사별로 미리 만들어 발행하는 "내 시간표만" 보기 문서.
    // 본인과 연결된 문서 하나만 읽을 수 있고, 쓰기는 관리자(발행 로직)만 — 교사 본인은 못 고친다.
    match /classswap_myview/{teacherId} {
      allow read: if isAdminRole() || (isApproved() && myTeacherId() == teacherId);
      allow write: if isAdminRole();
    }

    // 교사(일반) 역할이 "이 후보로 요청하기"를 눌러 만드는 문서. 본인 명의로만 만들 수 있고
    // (teacherId가 자기 연결된 교사와 같아야 함), 상태는 반드시 'pending'으로 시작 — 스스로
    // 승인 상태를 만들어 classswap/state에 영향을 주는 건 불가능하다(실제 반영은 관리자가
    // confirmDecision을 실행해야만 일어남). 읽기는 관리자 전체 + 본인 것만. 수정은 관리자만
    // (승인 처리), 삭제는 관리자이거나 본인이 아직 'pending'인 자기 요청을 취소할 때만.
    match /classswap_requests/{requestId} {
      allow create: if isApproved() && myTeacherId() != null
                     && request.resource.data.teacherId == myTeacherId()
                     && request.resource.data.status == 'pending';
      allow read: if isAdminRole() || (isApproved() && resource.data.teacherId == myTeacherId());
      allow update: if isAdminRole();
      allow delete: if isAdminRole()
                     || (isApproved() && resource.data.teacherId == myTeacherId() && resource.data.status == 'pending');
    }

    // 교사(일반) 계정이 "새 출장 등록"에서 제외할 교사를 고를 때 쓰는, 이름만 담긴 아주 작은
    // 공개 목록(과목·시간표·전문교과 등은 전혀 없음). 승인된 계정이면 누구나 읽을 수 있고,
    // 쓰기는 관리자(발행 로직)만.
    match /classswap_public/{docId} {
      allow read: if isApproved();
      allow write: if isAdminRole();
    }

    // 아직 승인 안 된 이메일로 로그인을 시도하면 본인 명의로 남기는 기록. 승인 전이라 다른 건
    // 전혀 못 읽고 쓰는 상태에서도 이 한 문서(자기 이메일)만은 만들 수 있게 해서, 관리자가
    // "관리자" 탭에서 보고 이메일을 몰라도 승인 버튼을 누를 수 있게 한다. 읽기/삭제는 관리자만 —
    // 본인도 자기가 시도했다는 기록 자체를 읽거나 지울 필요는 없다(승인되면 관리자 쪽에서 정리).
    match /classswap_login_attempts/{email} {
      allow create, update: if request.auth != null && myEmail() == email;
      allow read, delete: if isAdminRole();
    }

    // 그 외 경로는 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
