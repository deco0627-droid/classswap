rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 로그인했고(구글), edu.jkjin@gmail.com 고정 계정이거나 admins 컬렉션에 등록된 이메일만 승인.
    function isApproved() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'edu.jkjin@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
      );
    }

    // 교사·시간표·출장 데이터 전체가 들어있는 문서 하나.
    match /classswap/{docId} {
      allow read, write: if isApproved();
    }

    // 승인된 로그인 이메일 목록(문서 id = 소문자 이메일). 승인된 사람끼리 서로 추가/삭제 가능.
    match /admins/{email} {
      allow read, write: if isApproved();
    }

    // 그 외 경로는 전부 차단.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
